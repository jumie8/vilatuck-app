{
  "expo": {
    "name": "VILATUCK",
    "slug": "vilatuck",
    "scheme": "vilatuck",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vilatuck.app"
    },
    "android": {
      "package": "com.vilatuck.app",
      "adaptiveIcon": {
        "backgroundColor": "#09090F"
      }
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
